rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Les documents privés doivent être rangés sous documents/{uid}/...
    match /documents/{userId}/{allPaths=**} {
      allow read, write: if isOwner(userId);
    }

    // Les fichiers personnels doivent être rangés sous users/{uid}/...
    match /users/{userId}/{allPaths=**} {
      allow read, write: if isOwner(userId);
    }

    // Refus par défaut de tout chemin public ou non prévu.
  }
}
